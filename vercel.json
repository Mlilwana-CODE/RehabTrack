{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix RehabTrack",
  "buildCommand": "npm run build --prefix RehabTrack",
  "outputDirectory": "RehabTrack/.next",
  "headers": [
    { "source": "/dashboard", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] }
  ]
}
